# NEXORA Environment Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Privileged Access Keys (Replace in production!)
ORGANIZER_ACCESS_KEY=NEXORA-ORGANIZER-2026
ADMIN_ACCESS_KEY=NEXORA-ADMIN-2026

# JWT / Session Secrets
SESSION_SECRET=nexora_egspec_secure_session_secret_2026_dev
HASH_SALT_ROUNDS=10

# Local Storage Directory (Used as local fallback/ledger)
DATA_DIR=./data

# MongoDB Atlas Cloud Database (Required for persistent cloud deployments on Render / Vercel)
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nexora?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=nexora

# Firebase Project Configuration (Optional: for Firebase Auth/Hosting)
FIREBASE_PROJECT_ID=nexora-egspec-2026
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
